# ==============================================================================
# Web Chepita MTC - Environment Variables Template
# Copia este archivo a `.env.local` para desarrollo local:
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Variables Públicas del Cliente (Prefijo NEXT_PUBLIC_)
# Accesibles tanto en el navegador (cliente) como en el servidor (RSC).
# ------------------------------------------------------------------------------

# URL base del frontend local (Opcional en desarrollo local)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Endpoint base de la API REST v1 de Chepita MTC (REQUERIDO)
# Ejemplo para backend en la nube: https://project-d5c1b1cb-efd2-47ae-ad8.uc.r.appspot.com/api/v1
# Ejemplo para backend local: http://localhost:8080/api/v1
NEXT_PUBLIC_API_URL="https://project-d5c1b1cb-efd2-47ae-ad8.uc.r.appspot.com/api/v1"

# URL base del host para assets, uploads y archivos multimedia (REQUERIDO)
# Ejemplo: https://project-d5c1b1cb-efd2-47ae-ad8.uc.r.appspot.com
NEXT_PUBLIC_API_BASE="https://project-d5c1b1cb-efd2-47ae-ad8.uc.r.appspot.com"

# ------------------------------------------------------------------------------
# 2. Variables Privadas del Servidor (Sin prefijo NEXT_PUBLIC_)
# NUNCA se exponen al cliente. Utilizadas por Route Handlers o Server Actions.
# ------------------------------------------------------------------------------

# Entorno de ejecución (development | production | test)
NODE_ENV="development"

# Puerto de escucha del servidor web (Requerido para Google App Engine / Cloud Run)
PORT=8080

# Cadena de conexión a base de datos (Opcional: Si se conecta directamente vía ORM / Prisma / Drizzle)
# DATABASE_URL="postgresql://user:password@localhost:5432/chepita_db?schema=public"

# Secreto criptográfico para firma de tokens o sesiones (Mínimo 32 caracteres)
# AUTH_SECRET="your_placeholder_secret_32_chars_min_abcdef123456"
